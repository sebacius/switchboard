{
  "version": "1.0",
  "routes": [
    {
      "id": "route_aiagent",
      "name": "AiAgent",
      "pattern": "600",
      "priority": 10,
      "enabled": true,
      "actions": [
        {
          "type": "ai_agent",
          "params": {
            "config": "default.md",
            "voice": "alloy",
            "model": "llama3.1:8b"
          }
        }
      ]
    },
    {
      "id": "route_internal",
      "name": "Internal Extensions",
      "pattern": "1*",
      "priority": 50,
      "enabled": true,
      "actions": [
        {
          "type": "dial",
          "params": {
            "target": "user/${destination}",
            "timeout": 30
          }
        }
      ]
    },
    {
      "id": "route_park_queue",
      "name": "Park to Queue (auto-assign slot)",
      "pattern": "700",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "park",
          "params": {
            "moh_files": [
              "audio/audio1.wav",
              "audio/audio2.wav"
            ]
          }
        }
      ]
    },
    {
      "id": "route_park_slot",
      "name": "Park to Specific Slot",
      "pattern": "70[1-9]",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "park",
          "params": {
            "slot": "${destination}",
            "moh_files": ["audio/demo-congrats.wav"]
          }
        }
      ]
    },
    {
      "id": "route_unpark",
      "name": "Retrieve from Parking Slot",
      "pattern": "\\*70[0-9]",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "unpark",
          "params": {
            "slot": "${destination}"
          }
        }
      ]
    },
    {
      "id": "route_default",
      "name": "Default - Play Message",
      "pattern": "*",
      "priority": 1000,
      "enabled": true,
      "actions": [
        {
          "type": "play_audio",
          "params": {
            "file": "audio/demo-congrats.wav"
          }
        }
      ]
    }
  ]
}
