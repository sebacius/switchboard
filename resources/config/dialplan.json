{
  "version": "1.0",
  "routes": [
    {
      "id": "route_aiagent",
      "name": "AiAgent (after hours)",
      "pattern": "600",
      "priority": 10,
      "enabled": true,
      "actions": [
        {
          "type": "ai_agent",
          "params": {
            "config": "default",
            "voice": "alloy",
            "model": "llama3.1:8b",
            "mode": "conversational",
            "greeting": "Thank you for calling. Our office is currently closed, but I may be able to help you or take a message. What can I do for you?"
          }
        }
      ]
    },
    {
      "id": "route_aiagent_conversational",
      "name": "AiAgent Conversational",
      "pattern": "601",
      "priority": 10,
      "enabled": true,
      "actions": [
        {
          "type": "ai_agent",
          "params": {
            "config": "${domain}",
            "voice": "alloy",
            "model": "llama3.1:8b",
            "mode": "conversational"
          }
        }
      ]
    },
    {
      "id": "route_ivr",
      "name": "Main IVR",
      "pattern": "500",
      "priority": 10,
      "enabled": true,
      "actions": [
        {                                                                                                                                                                     
          "type": "tts",
          "params": {
            "text": "Hello, welcome to our service. This is the most insteresting experience i have ever had. Please press 1 for sales, 2 for support, or 3 for billing.",
            "voice": "alloy"
          }
        }
      ]
    },
    {
      "id": "route_internal",
      "name": "Internal Extensions",
      "pattern": "1*",
      "priority": 50,
      "enabled": true,
      "actions": [
        {
          "type": "dial",
          "params": {
            "target": "user/${destination}",
            "timeout": 30
          }
        }
      ]
    },
    {
      "id": "route_park_queue",
      "name": "Park to Queue (auto-assign slot)",
      "pattern": "700",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "park",
          "params": {
            "moh_files": [
              "audio/audio1.wav",
              "audio/audio2.wav"
            ]
          }
        }
      ]
    },
    {
      "id": "route_park_slot",
      "name": "Park to Specific Slot",
      "pattern": "70[1-9]",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "park",
          "params": {
            "slot": "${destination}",
            "moh_files": ["audio/demo-congrats.wav"]
          }
        }
      ]
    },
    {
      "id": "route_unpark",
      "name": "Retrieve from Parking Slot",
      "pattern": "\\*70[0-9]",
      "priority": 20,
      "enabled": true,
      "actions": [
        {
          "type": "unpark",
          "params": {
            "slot": "${destination}"
          }
        }
      ]
    },
    {
      "id": "route_default",
      "name": "Default - Play Message",
      "pattern": "*",
      "priority": 1000,
      "enabled": true,
      "actions": [
        {
          "type": "play_audio",
          "params": {
            "file": "audio/demo-congrats.wav"
          }
        }
      ]
    }
  ]
}
